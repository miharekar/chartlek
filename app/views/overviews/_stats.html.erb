<% card = "rounded-xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900/50" %>
<% label = "text-sm font-medium text-zinc-500 dark:text-zinc-400" %>
<% big = "mt-1 text-4xl font-semibold tabular-nums" %>
<% unit = "ml-1 text-sm font-normal text-zinc-500 dark:text-zinc-400" %>
<% longest = overview.longest %>

<section class="<%= card %> col-span-2">
  <h2 class="<%= label %>">Kilometers run</h2>
  <p class="mt-1 text-5xl font-semibold tabular-nums text-lime-700 dark:text-[#9CFF44]"><%= number_with_delimiter(overview.total_km.round) %><span class="<%= unit %>">km</span></p>
  <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400 first-letter:uppercase"><%= overview.total_km_in_words %></p>
  <p class="mt-3 text-sm tabular-nums text-zinc-600 dark:text-zinc-300"><%= pluralize(number_with_delimiter(overview.count), "run") %></p>
</section>

<section class="<%= card %> col-span-2">
  <h2 class="<%= label %>">Longest run</h2>
  <p class="<%= big %>"><%= overview_distance(longest.distance_m / 1000) %><span class="<%= unit %>">km</span></p>
  <p class="mt-1 text-sm tabular-nums text-zinc-600 dark:text-zinc-300">
    <%= link_to overview_date(longest.local_started_at), longest.external_url, target: "_blank", rel: "noopener", class: "underline decoration-zinc-300 hover:text-lime-700 dark:decoration-zinc-600 dark:hover:text-[#9CFF44]" %>
    <span class="text-zinc-500"><%= longest.name %></span>
  </p>
</section>

<% [[overview.most_often, "Most often run on"], [overview.least_often, "Least often run on"]].each do |weekday, title| %>
  <section class="<%= card %> col-span-2">
    <h2 class="<%= label %>"><%= title %></h2>
    <p class="mt-1 text-3xl font-semibold"><%= weekday.name %></p>
    <p class="mt-1 text-sm tabular-nums text-zinc-600 dark:text-zinc-300"><%= pluralize(number_with_delimiter(weekday.days), "day") %> · avg <%= overview_distance(weekday.average_km) %> km</p>
  </section>
<% end %>

<section class="<%= card %>">
  <h2 class="<%= label %>">Average run length</h2>
  <p class="<%= big %>"><%= overview_distance(overview.average_km) %><span class="<%= unit %>">km</span></p>
</section>

<section class="<%= card %>">
  <h2 class="<%= label %>">Average days per week</h2>
  <p class="<%= big %>"><%= overview_distance(overview.days_per_week) %><span class="<%= unit %>">days</span></p>
</section>

<section class="<%= card %>">
  <h2 class="<%= label %>">Time of day</h2>
  <div class="mt-1 flex items-center gap-3">
    <p class="<%= big %>"><%= overview.pm_percent %><span class="<%= unit %>">% PM</span></p>
    <div class="ml-auto size-12 shrink-0 rounded-full" title="<%= overview.pm_count %> PM, <%= overview.count - overview.pm_count %> AM" style="background: conic-gradient(var(--chart-accent) 0 <%= overview.pm_percent %>%, var(--chart-accent-low) 0); mask: radial-gradient(circle, transparent 55%, #000 56%); -webkit-mask: radial-gradient(circle, transparent 55%, #000 56%)"></div>
  </div>
</section>

<section class="<%= card %>">
  <h2 class="<%= label %>">Average pace</h2>
  <p class="<%= big %>"><%= overview_pace(overview.average_pace) %><span class="<%= unit %>">/km</span></p>
</section>
