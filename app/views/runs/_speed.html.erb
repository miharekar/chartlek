<section class="mt-4 <%= WidgetsHelper::CARD %>" data-controller="run-speed" data-run-speed-bars-value="<%= track.bars.to_json %>" data-run-speed-splits-value="<%= (run.splits || []).to_json %>" data-run-speed-steps-value="<%= (track.steps || []).to_json %>">
  <div class="<%= WidgetsHelper::CARD_HEADER %>">
    <h2 class="<%= WidgetsHelper::CARD_TITLE %>">
      Change in speed over route
    </h2>
    <% if run.splits.present? %>
      <%= button_group "Bar size" do %>
        <%= segment "per 100 m", selected: true, value: "bars", data: {action: "run-speed#unit", run_speed_target: "unit"} %>
        <%= segment "per km", value: "splits", data: {action: "run-speed#unit", run_speed_target: "unit"} %>
      <% end %>
    <% end %>
  </div>
  <div class="mt-1 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <p class="<%= WidgetsHelper::HINT %>">With a mouse, drag across the chart to summarize a stretch. On touch, drag to move the cursor.</p>
    <p class="<%= WidgetsHelper::HEADER_LINE %>" data-run-speed-target="stats"></p>
  </div>
  <div class="mt-3 h-56" data-run-speed-target="chart"></div>
</section>
