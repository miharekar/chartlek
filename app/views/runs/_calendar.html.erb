<% years = run.calendar_years %>
<% months = run.calendar_months %>
<nav class="mt-4 flex flex-col items-start gap-2" aria-label="Run calendar">
  <%= button_group "Year" do %>
    <% years.each do |year, id| %>
      <%= segment year, href: run_path(id), selected: year == run.local_started_at.year %>
    <% end %>
  <% end %>
  <%= button_group "Month" do %>
    <% (1..12).each do |month| %>
      <%= segment Date::ABBR_MONTHNAMES[month], href: (months[month] && run_path(months[month])), selected: month == run.local_started_at.month, disabled: months[month].nil? %>
    <% end %>
  <% end %>
  <div class="flex flex-wrap gap-0.5">
    <% run.calendar_days.each do |day| %>
      <%= run_calendar_day day, run %>
    <% end %>
  </div>
</nav>
