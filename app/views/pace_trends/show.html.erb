<%= tag.div data: (@pace_trend.runs.any? ? {controller: "pace-trends", pace_trends_payload_value: @pace_trend.payload} : {}) do %>
<%= page_header "Pace Trends", info: overview_info("#{vdot_explanation} Every run is a muted dot, scored by VDOT so all distances share one scale. Bright dots are top runs: the top 3 by score in the 30 days ending on that run. The band is the least-squares line through the top runs in the window, plus or minus one standard deviation of the residuals. Drag the timeline to change the window.") do %>
  <div class="flex flex-wrap items-center gap-2">
    <%= pace_trend_filter_chips %>
  </div>
<% end %>

<% if @pace_trend.runs.any? %>
  <div class="mt-6">
    <div class="flex flex-wrap items-start justify-between gap-x-8 gap-y-3">
      <div>
        <div class="text-sm font-semibold tabular-nums" data-pace-trends-target="range"></div>
        <div class="<%= WidgetsHelper::HINT %>">Pick a span or drag the timeline below to change the window.</div>
        <div class="mt-2"><%= pace_trend_presets %></div>
      </div>
      <div class="text-sm tabular-nums sm:text-right">
        <div data-pace-trends-target="change"></div>
        <div data-pace-trends-target="cut">
          <span data-pace-trends-target="verb"></span> <strong data-pace-trends-target="delta"></strong> from your estimated finish time
          <%= overview_info "Predicted time at the chosen distance from the regression VDOT at the start of the window versus the end. Faster is Cut, slower is Added." %>
          <div class="mt-2 sm:flex sm:justify-end">
            <%= button_group "Finish distance" do %>
              <% PaceTrend::DISTANCES.each do |label, _| %>
                <%= segment label, selected: label == @pace_trend.distance, data: {action: "pace-trends#changeDistance", pace_trends_target: "distance", distance: label} %>
              <% end %>
            <% end %>
          </div>
        </div>
        <div class="<%= WidgetsHelper::MUTED %>" data-pace-trends-target="message" hidden>Not enough top runs in this window to draw a trend.</div>
      </div>
    </div>
    <div data-pace-trends-target="chart" class="mt-3 w-full"></div>
    <div data-pace-trends-target="timeline" class="mt-2 w-full"></div>
  </div>
<% else %>
  <%= empty_state "No runs to show#{" with these filters" if request.query_parameters.slice("no_pauses", "no_indoor", "races").any?}." %>
<% end %>
<% end %>
