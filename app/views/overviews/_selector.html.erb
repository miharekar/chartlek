<% period = overview.period %>
<% years = overview.years(period.year) %>
<div class="mt-4 flex flex-col items-start gap-2">
  <%= button_group "Period", nav: true do %>
    <%= segment "All time", href: overview_path, selected: period.all_time? %>
    <% years.each do |year| %>
      <%= segment year, href: overview_period_path(year), selected: period.year == year %>
    <% end %>
  <% end %>
  <% if period.year %>
    <% active_months = overview.months_with_runs(period.year) %>
    <%= button_group "Month", nav: true do %>
      <% (1..12).each do |month| %>
        <%= segment Date::ABBR_MONTHNAMES[month], href: (period.month == month ? overview_period_path(period.year) : overview_period_path(period.year, month)), selected: period.month == month, disabled: !active_months.include?(month) && period.month != month %>
      <% end %>
    <% end %>
  <% end %>
</div>
