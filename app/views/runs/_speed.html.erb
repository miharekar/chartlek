<section class="mt-4 <%= WidgetsHelper::CARD %>" data-controller="run-speed" data-run-speed-bars-value="<%= track.bars.to_json %>" data-run-speed-splits-value="<%= (run.splits || []).to_json %>">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2 class="<%= WidgetsHelper::CARD_TITLE %>">
      Change in speed over route
    </h2>
    <% if run.splits.present? %>
      <div class="flex gap-1 rounded-lg bg-zinc-100 p-1 dark:bg-zinc-900" role="group" aria-label="Bar size">
        <button type="button" data-action="run-speed#unit" data-run-speed-target="unit" value="bars" aria-pressed="true" class="<%= pr_progress_button_class %>">per 100 m</button>
        <button type="button" data-action="run-speed#unit" data-run-speed-target="unit" value="splits" aria-pressed="false" class="<%= pr_progress_button_class %>">per km</button>
      </div>
    <% end %>
    <p class="text-sm tabular-nums text-zinc-600 dark:text-zinc-300" data-run-speed-target="stats"></p>
  </div>
  <p class="mt-1 <%= WidgetsHelper::HINT %>">Drag across the chart to summarise a stretch.</p>
  <div class="mt-3 h-56" data-run-speed-target="chart"></div>
</section>
