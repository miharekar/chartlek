<%= page_header runs_period_title(@year, @month), title: "Runs · #{runs_period_title(@year, @month)}" do %>
  <p class="text-sm tabular-nums <%= WidgetsHelper::MUTED %>"><%= pluralize(number_with_delimiter(@runs.size), "run") %></p>
<% end %>

<% if @gear == "none" %>
  <p class="mt-2 text-sm <%= WidgetsHelper::MUTED %>">
    Runs linked to Strava with no gear set.
    <%= overview_info "Set the gear on Strava; a recent run leaves this list after the next sync, an older one after Refresh from Strava on the Gear page." %>
  </p>
<% elsif @filter_gear %>
  <p class="mt-2 text-sm <%= WidgetsHelper::MUTED %>">Gear: <span class="font-medium text-zinc-900 dark:text-zinc-100"><%= @filter_gear.display_name %></span> · <%= link_to "Show all gear", runs_path(year: @year || "all", month: @month), class: WidgetsHelper::LINK %></p>
<% end %>

<%= render "selector", year: @year, month: @month, gear: @gear %>

<% if @runs.empty? && @gear == "none" && @year.nil? %>
  <%= empty_state "Every run linked to Strava has gear set." do %>
    <%= link_to "Show all gear", gears_path, class: WidgetsHelper::LINK %>
  <% end %>
<% elsif @runs.empty? %>
  <%= empty_state "No runs in #{runs_period_title(@year, @month).downcase.sub("all time", "your history")} yet." do %>
    <% if @year %>
      <%= link_to "Show all time", runs_path(year: "all", gear: @gear), class: WidgetsHelper::LINK %>
    <% end %>
  <% end %>
<% else %>
  <section class="mt-6 <%= WidgetsHelper::CARD %>">
    <div class="overflow-x-auto">
      <table class="<%= WidgetsHelper::TABLE %>">
        <thead class="<%= WidgetsHelper::TABLE_HEAD %>">
          <tr class="<%= WidgetsHelper::TABLE_HEAD_ROW %>">
            <% RunsHelper::COLUMNS.each do |label, key, align| %>
              <%= runs_sort_header label, key, align %>
            <% end %>
            <th class="<%= WidgetsHelper::CELL %> text-left font-medium">Tags &amp; gear</th>
            <% if @suggestions %>
              <th class="<%= WidgetsHelper::CELL %> text-left font-medium">Suggested</th>
              <th class="<%= WidgetsHelper::CELL %>"></th>
            <% end %>
          </tr>
        </thead>
        <tbody class="<%= WidgetsHelper::TABLE_BODY %>">
          <% @runs.each do |run| %>
            <tr class="<%= WidgetsHelper::TABLE_ROW %>">
              <td class="<%= WidgetsHelper::CELL %> text-zinc-600 dark:text-zinc-300"><%= link_to overview_date(run.local_started_at), run_path(run), class: WidgetsHelper::TABLE_LINK %></td>
              <td class="<%= WidgetsHelper::CELL %> max-w-md font-medium"><%= link_to run.name.presence || "Run", run_path(run), class: WidgetsHelper::TABLE_LINK %></td>
              <td class="<%= WidgetsHelper::CELL %> text-right"><%= overview_distance(run.distance_m / 1000) %></td>
              <td class="<%= WidgetsHelper::CELL %> text-right"><%= overview_pace(run.pace) %></td>
              <td class="<%= WidgetsHelper::CELL %> text-right"><%= run.elevation_gain_m&.round %></td>
              <td class="<%= WidgetsHelper::CELL %>">
                <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                  <% tags = run_tags(run) %>
                  <% gear = run_gear_tag(run) %>
                  <%= tag.div tags if tags.present? %>
                  <%= tag.div gear if gear.present? %>
                </div>
              </td>
              <% if @suggestions %>
                <% suggested = @suggestions[run.id] %>
                <td class="<%= WidgetsHelper::CELL %>"><%= link_to suggested.display_name, runs_path(gear: suggested.strava_id, year: "all"), class: WidgetsHelper::TABLE_LINK if suggested %></td>
                <td class="<%= WidgetsHelper::CELL %>"><%= action_button "Open in Strava", run.strava_url, target: "_blank", rel: "noopener" %></td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>
