<% series = track.data.slice("d", "alt", "hr", "cad") %>
<% if series.key?("alt") || series.key?("hr") || series.key?("cad") %>
  <section class="mt-4 rounded-xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900/50" data-controller="run-profiles" data-run-profiles-series-value="<%= series.to_json %>">
    <h2 class="font-semibold">Elevation, heart rate and cadence</h2>
    <div class="mt-3" data-run-profiles-target="chart"></div>
  </section>
<% end %>
