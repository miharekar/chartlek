<% zones = HrZones.for(@run) if @run.avg_hr || @run.hr_zone_times(nil) %>
<%= render "header", run: @run %>
<%= render "notables", run: @run %>
<%= render "tiles", run: @run %>
<% if @run.track %>
  <%= render "map", run: @run, track: @run.track %>
  <% if @run.splits.present? %>
    <%= render "speed", run: @run, track: @run.track %>
  <% end %>
  <%= render "profiles", track: @run.track, zones: zones %>
<% end %>
<% if @run.workout? %>
  <%= render "workout", run: @run %>
<% end %>
<%= render "physiology", run: @run, zones: zones %>
<%= render "fastest", run: @run %>
<%= render "analyze", run: @run %>
