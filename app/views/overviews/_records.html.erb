<% records = overview.records %>
<% if records.any? %>
<% th = "px-3 py-2 text-right font-medium" %>
<section class="mt-4 rounded-xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900/50">
  <h2 class="font-semibold">Personal records</h2>
  <div class="mt-3 overflow-x-auto">
    <table class="w-full text-sm tabular-nums">
      <thead class="text-zinc-500 dark:text-zinc-400">
        <tr class="border-b border-zinc-200 dark:border-zinc-800">
          <th class="px-3 py-2 text-left font-medium">Distance</th>
          <th class="px-3 py-2 text-left font-medium">Date</th>
          <th class="<%= th %>">Pace</th>
          <th class="<%= th %>">km/h</th>
          <th class="<%= th %>">Time</th>
          <th class="<%= th %>">Runs</th>
          <th class="px-3 py-2"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800/60">
        <% records.each do |record| %>
          <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-800/40">
            <td class="px-3 py-2 font-medium"><%= link_to record.name, record.activity.external_url, target: "_blank", rel: "noopener", class: "hover:text-lime-700 dark:hover:text-[#9CFF44]" %></td>
            <td class="px-3 py-2 text-zinc-600 dark:text-zinc-300"><%= link_to overview_date(record.activity.local_started_at), record.activity.external_url, target: "_blank", rel: "noopener", class: "hover:underline" %></td>
            <td class="px-3 py-2 text-right"><%= overview_pace(record.pace) %> <span class="text-xs text-zinc-500">/km</span></td>
            <td class="px-3 py-2 text-right"><%= format("%.2f", record.speed_kmh) %></td>
            <td class="px-3 py-2 text-right font-medium"><%= overview_duration(record.time_s) %></td>
            <td class="px-3 py-2 text-right text-zinc-500"><%= number_with_delimiter(record.count) %></td>
            <td class="px-3 py-2"><% if record.race %><span class="rounded bg-amber-100 px-1.5 py-0.5 text-xs font-medium text-amber-800 dark:bg-amber-900/40 dark:text-amber-300">race</span><% end %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <p class="mt-3 text-xs text-zinc-500 dark:text-zinc-400">All distances are rounded down and times are interpolated.</p>
</section>
<% end %>
