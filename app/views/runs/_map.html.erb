<% route = track.route %>
<% token = ENV["MAPBOX_TOKEN"].to_s %>
<% if route.size > 1 && token.start_with?("pk.") %>
  <section class="mt-4 rounded-xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900/50">
    <h2 class="font-semibold">Route</h2>
    <div class="isolate mt-3 h-96 overflow-hidden rounded-lg" data-controller="run-map" data-run-map-route-value="<%= route.to_json %>" data-run-map-token-value="<%= token %>"></div>
  </section>
<% end %>
