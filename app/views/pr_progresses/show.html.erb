<% if @pr_progress.empty? %>
  <%= page_header "Performance", title: "PR Progress" %>
  <%= render "performance_tabs", current: :pr_progress %>
  <%= empty_state "No runs to show yet." %>
<% else %>
  <%= tag.div data: {controller: "pr-progress", pr_progress_data_value: @pr_progress.data, pr_progress_mode_value: @mode, pr_progress_days_value: @days} do %>
    <%= page_header "Performance", title: "PR Progress", info: overview_info("Every run by distance and pace. Distance across on a log scale, pace up (faster is higher). The solid line is your all-time best at each benchmark distance; what lies above it is still to be achieved. The dashed line is your best at each distance inside the window below. PRs you can beat predicts each distance from the best VDOT run of the last 30, 60 or 90 days, or any run you click. Magic PRs shows the next round time below each PR, with the three closest targets pulsing.") do %>
      <%= button_group "Mode" do %>
        <%= segment "Progress", data: {action: "pr-progress#setMode", mode: "progress"} %>
        <%= segment "PRs you can beat", data: {action: "pr-progress#setMode", mode: "beat"} %>
        <%= segment "Magic PRs", data: {action: "pr-progress#setMode", mode: "magic"} %>
      <% end %>
    <% end %>
    <%= render "performance_tabs", current: :pr_progress %>

    <div class="mt-6">
      <%= render "window_block", controller: "pr-progress" %>
    </div>

    <section class="mt-4 <%= WidgetsHelper::CARD %>">
      <div class="mb-3 flex min-h-8 flex-wrap items-center gap-x-4 gap-y-2 text-sm">
        <div class="hidden flex-wrap items-center gap-3" data-pr-progress-target="beat">
          <span class="<%= WidgetsHelper::MUTED %>">Best run of the last</span>
          <%= button_group "Reference period" do %>
            <% PrProgress::REFERENCE_DAYS.each do |days| %>
              <%= segment "#{days} days", data: {action: "pr-progress#setDays", days: days} %>
            <% end %>
          <% end %>
          <span class="<%= WidgetsHelper::MUTED %>" data-pr-progress-target="reference"></span>
        </div>
        <p class="hidden <%= WidgetsHelper::HINT %>" data-pr-progress-target="magic">Next round time below each PR. The three closest targets pulse.</p>
        <div class="ml-auto <%= WidgetsHelper::LEGEND %>" data-pr-progress-target="legend"></div>
      </div>
      <div data-pr-progress-target="chart" class="relative"></div>
    </section>
    <div data-pr-progress-target="timeline" class="mt-3 w-full"></div>

    <section class="mt-4 <%= WidgetsHelper::CARD %>">
      <h2 class="<%= WidgetsHelper::CARD_TITLE %>">
        Best in window
        <%= overview_info "The table compares your best at each distance in the window with your all-time PR, and shows days since your last run at that distance and since your PR as it stood at the end of the window." %>
      </h2>
      <div class="mt-3 overflow-x-auto">
        <table class="<%= WidgetsHelper::TABLE %>" data-pr-progress-target="table"></table>
      </div>
    </section>
  <% end %>
<% end %>
