<% period = @overview.period %>
<% latest = @overview.latest %>
<%= page_header overview_period_title(period) do %>
  <% if latest %>
    <%= action_button "Latest run · #{latest.local_started_at.strftime("%-d %b")} · #{overview_distance(latest.distance_m / 1000.0)} km →", run_path(latest) %>
  <% end %>
<% end %>

<%= render "selector", overview: @overview %>

<% if @overview.empty? %>
  <% if @overview.goal_tiles.any? %>
    <div class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
      <%= render partial: "goal_tile", collection: @overview.goal_tiles, as: :slot, locals: {span: goal_tile_span(@overview.goal_tiles)} %>
    </div>
  <% end %>
  <%= render "empty", period: period, goal: @overview.goal_to_create %>
<% else %>
  <div class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
    <%= render "stats", overview: @overview %>
  </div>

  <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-2">
    <%= render "distance_bars", overview: @overview %>
    <%= render "trailing", overview: @overview %>
    <%= render "pace_scatter", overview: @overview %>
    <%= render "streaks", overview: @overview %>
  </div>

  <%= render "heatmap", overview: @overview %>
  <%= render "records", overview: @overview %>
<% end %>
