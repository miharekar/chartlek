<%= page_header runs_period_title(@year, @month) do %>
  <p class="text-sm tabular-nums <%= WidgetsHelper::MUTED %>"><%= pluralize(number_with_delimiter(@runs.size), "run") %></p>
<% end %>

<%= render "selector", year: @year, month: @month %>

<% if @runs.empty? %>
  <%= empty_state "No runs in #{runs_period_title(@year, @month).downcase.sub("all time", "your history")} yet." do %>
    <% if @year %>
      <%= link_to "Show all time", runs_path(year: "all"), class: WidgetsHelper::LINK %>
    <% end %>
  <% end %>
<% else %>
  <section class="mt-6 <%= WidgetsHelper::CARD %>">
    <div class="overflow-x-auto">
      <table class="<%= WidgetsHelper::TABLE %>">
        <thead class="<%= WidgetsHelper::TABLE_HEAD %>">
          <tr class="<%= WidgetsHelper::TABLE_HEAD_ROW %>">
            <% RunsHelper::COLUMNS.each do |label, key, align| %>
              <%= runs_sort_header label, key, align, info: (key == "vdot") %>
            <% end %>
            <th class="<%= WidgetsHelper::CELL %>"></th>
          </tr>
        </thead>
        <tbody class="<%= WidgetsHelper::TABLE_BODY %>">
          <% @runs.each do |run| %>
            <tr class="<%= WidgetsHelper::TABLE_ROW %>">
              <td class="<%= WidgetsHelper::CELL %> text-zinc-600 dark:text-zinc-300"><%= link_to overview_date(run.local_started_at), run_path(run), class: WidgetsHelper::TABLE_LINK %></td>
              <td class="<%= WidgetsHelper::CELL %> font-medium"><%= link_to run.name.presence || "Run", run_path(run), class: WidgetsHelper::TABLE_LINK %></td>
              <td class="<%= WidgetsHelper::CELL %> text-right"><%= overview_distance(run.distance_m / 1000) %></td>
              <td class="<%= WidgetsHelper::CELL %> text-right"><%= overview_duration(run.timer_s) %></td>
              <td class="<%= WidgetsHelper::CELL %> text-right"><%= overview_pace(run.pace) %></td>
              <td class="<%= WidgetsHelper::CELL %> text-right"><%= run.avg_hr %></td>
              <td class="<%= WidgetsHelper::CELL %> text-right"><%= run.elevation_gain_m&.round %></td>
              <td class="<%= WidgetsHelper::CELL %> text-right"><%= run.vdot&.round(1) %></td>
              <td class="<%= WidgetsHelper::CELL %>"><%= run_tags(run) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>
