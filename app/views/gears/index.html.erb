<%= page_header "Gear" do %>
  <% if @profile.strava_gear_access? %>
    <%= button_to "Refresh from Strava", gear_sync_path, class: ControlsHelper::BUTTON %>
  <% end %>
<% end %>

<% if !@profile.strava_gear_access? %>
  <%= empty_state "Gear needs Strava profile access." do %>
    Use Reconnect Strava (or Connect Strava) in the nav bar and leave the profile access ticked.
  <% end %>
<% elsif @profile.strava_gear_scan_failed? %>
  <%= empty_state "The first gear scan failed." do %>
    Strava did not answer it twice, so it is not retried every hour. Start it again with Refresh from Strava.
  <% end %>
<% elsif !@ready %>
  <%= empty_state "The first gear scan is pending." do %>
    Your runs and their gear appear here when it finishes. Reload in a minute, or start it with Refresh from Strava.
  <% end %>
<% elsif @usage.empty? && @unset.nil? %>
  <%= empty_state "No gear found on your linked Strava runs yet." %>
<% else %>
  <% active, retired = @usage.partition { !it.gear.retired } %>
  <section class="mt-6 <%= WidgetsHelper::CARD %>">
    <%= render "table", rows: active, unset: @unset %>
  </section>

  <% if retired.any? %>
    <section class="mt-4 <%= WidgetsHelper::CARD %>" data-controller="disclosure">
      <%= toggle_button "Retired (#{retired.size})", data: {disclosure_target: "button", action: "disclosure#toggle"} %>
      <div class="mt-3" data-disclosure-target="panel" hidden>
        <%= render "table", rows: retired, unset: nil %>
      </div>
    </section>
  <% end %>

  <% if @chart[:months].any? %>
    <%= tag.div class: "mt-4 space-y-4", data: {controller: "gear-charts", gear_charts_data_value: @chart} do %>
      <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Gear shown in the charts">
        <% @usage.each do |row| %>
          <%= toggle_button safe_join([tag.span("", class: "mr-2 size-2.5 shrink-0 rounded-full ring-1 ring-white/70", data: {swatch: ""}), row.gear.display_name]), pressed: !row.gear.retired, data: {gear_charts_target: "toggle", id: row.gear.strava_id, action: "gear-charts#toggle"} %>
        <% end %>
      </div>
      <section class="<%= WidgetsHelper::CARD %>">
        <h2 class="<%= WidgetsHelper::CARD_TITLE %>">Distance per month</h2>
        <div class="mt-3 h-64" data-gear-charts-target="bars" data-label="Stacked bars of distance per month for each gear"></div>
      </section>
      <section class="<%= WidgetsHelper::CARD %>">
        <h2 class="<%= WidgetsHelper::CARD_TITLE %>">Distance over time</h2>
        <div class="mt-3 h-64" data-gear-charts-target="lines" data-label="Cumulative distance over time for each gear"></div>
      </section>
    <% end %>
  <% end %>
<% end %>
