<% years = Activity.years_with_runs %>
<% years = ([year] + years).compact.uniq.sort.reverse %>
<div class="mt-4 flex flex-col items-start gap-2">
  <%= button_group "Period", nav: true do %>
    <%= segment "All", href: runs_path(year: "all", gear:), selected: year.nil? %>
    <% years.each do |candidate| %>
      <%= segment candidate, href: runs_path(year: candidate, gear:), selected: year == candidate %>
    <% end %>
  <% end %>
  <% if year %>
    <% active_months = Activity.months_with_runs(year) %>
    <%= button_group "Month", nav: true do %>
      <% (1..12).each do |number| %>
        <%= segment Date::ABBR_MONTHNAMES[number], href: runs_path(year:, month: (month == number ? nil : number), gear:), selected: month == number, disabled: !active_months.include?(number) && month != number %>
      <% end %>
    <% end %>
  <% end %>
</div>
