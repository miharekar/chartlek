<% period = @overview.period %>
<div class="flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-semibold"><%= overview_period_title(period) %></h1>
  <% latest = @overview.latest %>
  <% if latest %>
    <%= link_to "Latest run · #{latest.local_started_at.strftime("%-d %b")} · #{overview_distance(latest.distance_m / 1000.0)} km →", run_path(latest), class: "rounded-md border border-zinc-300 px-2.5 py-1 text-sm tabular-nums text-zinc-700 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-300 dark:hover:bg-zinc-900" %>
  <% end %>
</div>

<%= render "selector", overview: @overview %>

<% if @overview.empty? %>
  <%= render "empty", period: period %>
<% else %>
  <div class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
    <%= render "stats", overview: @overview %>
  </div>

  <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-2">
    <%= render "distance_bars", overview: @overview %>
    <%= render "trailing", overview: @overview %>
    <%= render "pace_scatter", overview: @overview %>
    <%= render "streaks", overview: @overview %>
  </div>

  <%= render "heatmap", overview: @overview %>
  <%= render "records", overview: @overview %>
<% end %>
