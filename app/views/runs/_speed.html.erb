<section class="mt-4 rounded-xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900/50" data-controller="run-speed" data-run-speed-bars-value="<%= track.bars.to_json %>" data-run-speed-splits-value="<%= (run.splits || []).to_json %>">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h2 class="font-semibold">
      Change in speed over route
    </h2>
    <% if run.splits.present? %>
      <div class="flex gap-1 rounded-lg bg-zinc-100 p-1 dark:bg-zinc-900" role="group" aria-label="Bar size">
        <button type="button" data-action="run-speed#unit" data-run-speed-target="unit" value="bars" aria-pressed="true" class="<%= pr_progress_button_class %>">per 100 m</button>
        <button type="button" data-action="run-speed#unit" data-run-speed-target="unit" value="splits" aria-pressed="false" class="<%= pr_progress_button_class %>">per km</button>
      </div>
    <% end %>
    <p class="text-sm tabular-nums text-zinc-600 dark:text-zinc-300" data-run-speed-target="stats"></p>
  </div>
  <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Drag across the chart to summarise a stretch.</p>
  <div class="mt-3 h-56" data-run-speed-target="chart"></div>
  <% elevation = track.chart_metrics&.dig("elevation") %>
  <% if elevation.present? %>
    <div class="mt-4" data-run-speed-target="elevation" data-controller="recording-bars" data-recording-bars-kind-value="elevation" data-recording-bars-samples-value="<%= elevation.to_json %>">
      <h3 class="flex items-center gap-1.5 font-semibold">Elevation change <%= overview_info "Height gained above zero, height lost below zero, in each distance interval. One interval can have both. Uses the full recording with a 1 m noise threshold carried across boundaries. The 1 km view sums the same 100 m bins. Missing elevation is not bridged; hover or focus shows incomplete intervals. Recorded totals may differ from the summary." %></h3>
      <div class="mt-2" data-recording-bars-target="chart" role="group" aria-label="Elevation gained and lost along the route"></div>
      <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Green: gained. Amber: lost. Uses the speed chart's 100 m / km toggle.</p>
    </div>
  <% end %>
</section>
