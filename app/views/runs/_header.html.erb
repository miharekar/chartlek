<% previous = run.previous_run %>
<% following = run.next_run %>
<% same_day = run.same_day_runs.to_a %>
<header>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="flex items-center gap-2 text-2xl font-semibold"><%= run.name.presence || "Run" %> <%= run_tags(run) %></h1>
      <p class="mt-1 text-sm tabular-nums text-zinc-600 dark:text-zinc-300">
        <%= run.local_started_at.strftime("%A, %-d %B %Y") %> · <%= run_clock(run) %>
        <% if run.location_name.present? %>· <%= run.location_name %><% end %>
      </p>
      <% if run.weather.present? %>
        <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400"><%= run_weather(run.weather) %></p>
      <% end %>
    </div>
    <nav class="flex flex-wrap items-center gap-2" aria-label="Runs">
      <%= action_button "← Previous", run_path(previous) if previous %>
      <%= action_button "Next →", run_path(following) if following %>
      <% if run.garmin_url %>
        <%= action_button "Open in Garmin", run.garmin_url, target: "_blank", rel: "noopener" %>
      <% end %>
      <% if run.strava_url %>
        <%= action_button "Open in Strava", run.strava_url, target: "_blank", rel: "noopener" %>
      <% end %>
    </nav>
  </div>
  <%= render "calendar", run: run %>
  <% if same_day.size > 1 %>
    <nav class="mt-3 flex flex-wrap items-center gap-1" aria-label="Runs that day">
      <% same_day.each do |sibling| %>
        <%= overview_pill "#{sibling.local_started_at.strftime("%H:%M")} · #{overview_distance(sibling.distance_m / 1000)} km", run_path(sibling), (sibling.id == run.id) ? :selected : :idle %>
      <% end %>
    </nav>
  <% end %>
</header>
