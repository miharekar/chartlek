<% notables = Notables.for(run, run.earlier_runs) %>
<% if notables.any? %>
  <section class="mt-4 rounded-xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900/50">
    <h2 class="font-semibold">Notables</h2>
    <ul class="mt-3 list-inside list-disc space-y-1 text-sm text-zinc-700 dark:text-zinc-300">
      <% notables.each do |notable| %>
        <li><%= notable %></li>
      <% end %>
    </ul>
  </section>
<% end %>
