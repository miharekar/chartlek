<% metrics = pro_map_metrics(@run, @track, @zones) %>
<% ranked = @run.splits.present? %>
<% efforts = ranked ? @track.efforts : [] %>
<% splits = ranked ? pro_map_splits(@run) : [] %>
<% row = "cursor-pointer #{WidgetsHelper::TABLE_ROW} has-[[aria-pressed=true]]:bg-lime-50 dark:has-[[aria-pressed=true]]:bg-lime-950/40" %>
<%= page_header "Pro Map" do %>
  <nav class="flex flex-wrap items-center gap-2" aria-label="Run">
    <%= action_button "← Back to run", run_path(@run) %>
  </nav>
<% end %>
<p class="mt-1 <%= WidgetsHelper::HEADER_LINE %>"><%= @run.name.presence || "Run" %> · <%= @run.local_started_at.strftime("%A, %-d %B %Y") %> · <%= run_clock(@run) %></p>

<div data-controller="pro-map" data-pro-map-data-value="<%= @track.data.to_json %>" data-pro-map-token-value="<%= mapbox_token %>" data-pro-map-floors-value="<%= (@zones&.floors || []).to_json %>" data-pro-map-pace-labels-value="<%= (0...PaceZones::COUNT).map { PaceZones.label(it) }.to_json %>" data-pro-map-metric-value="<%= metrics.keys.first %>">
  <section class="mt-4 <%= WidgetsHelper::CARD %>">
    <div class="<%= WidgetsHelper::CARD_HEADER %>">
      <h2 class="<%= WidgetsHelper::CARD_TITLE %>">Route</h2>
      <% if metrics.any? %>
        <%= button_group "Color route by" do %>
          <% metrics.each_with_index do |(key, label), index| %>
            <%= segment label, selected: index.zero?, value: key, data: {action: "click->pro-map#metric mouseenter->pro-map#overlay mouseleave->pro-map#unoverlay focus->pro-map#overlay blur->pro-map#unoverlay", pro_map_target: "metric"} %>
          <% end %>
        <% end %>
      <% end %>
    </div>
    <div class="isolate mt-3 h-[60vh] min-h-80 overflow-hidden rounded-lg" data-pro-map-target="map"></div>
    <p class="mt-3 <%= WidgetsHelper::HEADER_LINE %>" aria-live="polite" data-pro-map-target="stats"></p>
    <% if metrics.any? %>
      <p class="mt-3 <%= WidgetsHelper::HINT %>">Click a bar to select it. Click again for it and above, again for it and below, and once more to reset.</p>
      <div class="mt-2 flex h-32 items-stretch gap-1" role="group" aria-label="Distribution" data-pro-map-target="bars"></div>
    <% end %>
  </section>

  <% if ranked %>
    <section class="mt-4 <%= WidgetsHelper::CARD %>">
      <h2 class="<%= WidgetsHelper::CARD_TITLE %>">Change in pace</h2>
      <p class="mt-1 <%= WidgetsHelper::HINT %>">Hover the graph to follow it on the map. Hover a metric above to overlay it.</p>
      <div class="mt-3 h-56" data-pro-map-target="graph"></div>
    </section>
  <% end %>

  <% if efforts.any? || splits.any? %>
    <div class="mt-4 grid gap-4 lg:grid-cols-2">
      <% if efforts.any? %>
        <section class="<%= WidgetsHelper::CARD %>">
          <h2 class="<%= WidgetsHelper::CARD_TITLE %>">
            Fastest segments
            <%= overview_info "The fastest stretch of each distance, found on the run's stored track. The track keeps at most 2,000 points, so on long runs a segment's start, end and time are approximate." %>
          </h2>
          <div class="mt-3 overflow-x-auto">
            <table class="<%= WidgetsHelper::TABLE %>">
              <thead class="<%= WidgetsHelper::TABLE_HEAD %>">
                <tr class="<%= WidgetsHelper::TABLE_HEAD_ROW %>">
                  <th class="<%= WidgetsHelper::CELL %> text-left font-medium">Distance</th>
                  <th class="<%= WidgetsHelper::CELL %> text-right font-medium">Time</th>
                  <th class="<%= WidgetsHelper::CELL %> text-right font-medium">Pace</th>
                  <th class="<%= WidgetsHelper::CELL %> text-right font-medium">VDOT</th>
                </tr>
              </thead>
              <tbody class="<%= WidgetsHelper::TABLE_BODY %>">
                <% efforts.each do |effort| %>
                  <tr class="<%= row %>" data-pro-map-target="range" data-from="<%= effort[:from].round(1) %>" data-to="<%= effort[:to].round(1) %>" data-action="click->pro-map#isolate">
                    <td class="<%= WidgetsHelper::CELL %>"><button type="button" class="cursor-pointer <%= WidgetsHelper::TABLE_LINK %>" aria-pressed="false"><%= effort[:label] %></button></td>
                    <td class="<%= WidgetsHelper::CELL %> text-right"><%= overview_duration(effort[:time]) %></td>
                    <td class="<%= WidgetsHelper::CELL %> text-right"><%= overview_pace(effort[:pace]) %> /km</td>
                    <td class="<%= WidgetsHelper::CELL %> text-right"><%= effort[:vdot] ? effort[:vdot].round(1) : "–" %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>

      <% if splits.any? %>
        <section class="<%= WidgetsHelper::CARD %>" data-pro-map-target="splits">
          <h2 class="<%= WidgetsHelper::CARD_TITLE %>">Splits</h2>
          <div class="mt-3 overflow-x-auto">
            <table class="<%= WidgetsHelper::TABLE %>">
              <thead class="<%= WidgetsHelper::TABLE_HEAD %>">
                <tr class="<%= WidgetsHelper::TABLE_HEAD_ROW %>">
                  <th class="<%= WidgetsHelper::CELL %> text-left font-medium">km</th>
                  <th class="<%= WidgetsHelper::CELL %> text-right font-medium">Time</th>
                  <th class="<%= WidgetsHelper::CELL %> text-right font-medium" data-metric="pace">Pace</th>
                  <th class="<%= WidgetsHelper::CELL %> text-right font-medium" data-metric="hr">HR</th>
                  <th class="<%= WidgetsHelper::CELL %> text-right font-medium" data-metric="grade">Elevation</th>
                  <th class="<%= WidgetsHelper::CELL %> text-right font-medium" data-metric="cadence">Cadence</th>
                </tr>
              </thead>
              <tbody class="<%= WidgetsHelper::TABLE_BODY %>">
                <% splits.each do |split| %>
                  <tr class="<%= row %>" data-pro-map-target="range" data-from="<%= split["from"].round(1) %>" data-to="<%= split["to"].round(1) %>" data-action="click->pro-map#isolate">
                    <td class="<%= WidgetsHelper::CELL %>"><button type="button" class="cursor-pointer <%= WidgetsHelper::TABLE_LINK %>" aria-pressed="false"><%= overview_distance(split["to"] / 1000) %></button></td>
                    <td class="<%= WidgetsHelper::CELL %> text-right"><%= overview_duration(split["time"]) %></td>
                    <td class="<%= WidgetsHelper::CELL %> text-right" data-metric="pace"><%= overview_pace(split["pace"]) %> /km</td>
                    <td class="<%= WidgetsHelper::CELL %> text-right" data-metric="hr"><%= split["hr"] ? "#{split["hr"]} bpm" : "–" %></td>
                    <td class="<%= WidgetsHelper::CELL %> text-right" data-metric="grade"><%= pro_map_gain(split) || "–" %></td>
                    <td class="<%= WidgetsHelper::CELL %> text-right" data-metric="cadence"><%= split["cad"] ? "#{split["cad"]} spm" : "–" %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>
    </div>
  <% end %>
</div>
