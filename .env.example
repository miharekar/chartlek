# Copy to .env and fill in. Keep .env private: never commit it.

# Required

# Garmin Personal API key (connect.garmin.com/app/settings/personalApiToken)
GARMIN_API_TOKEN=

# Rails session and message secret, also encrypts the stored Strava tokens: openssl rand -hex 64. Keep it; a new one means reconnecting Strava
SECRET_KEY_BASE=

# Optional

# Strava API app, for the years before Garmin and gear (strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_SECRET=

# Smashrun login, only for the pre-Garmin backfill
SMASHRUN_USERNAME=
SMASHRUN_PASSWORD=

# Mapbox public token (starts with pk.), enables the maps. Never use a secret sk. token
MAPBOX_TOKEN=

# Puma tuning
# RAILS_MAX_THREADS=3
# WEB_CONCURRENCY=
# JOB_CONCURRENCY=1
# RAILS_LOG_LEVEL=info
