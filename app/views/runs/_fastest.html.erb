<section class="mt-4 <%= WidgetsHelper::CARD %>">
  <h2 class="<%= WidgetsHelper::CARD_TITLE %>">Fastest runs at this distance</h2>
  <div class="mt-3 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
    <% (Activity::FASTEST_WINDOWS + [nil]).each do |days| %>
      <div>
        <h3 class="<%= WidgetsHelper::TILE_LABEL %>"><%= days ? "Last #{days} days" : "All time" %></h3>
        <table class="mt-2 w-full text-sm tabular-nums">
          <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800/60">
            <% run.fastest_similar(days).each do |other| %>
              <tr class="<%= "bg-lime-50 font-medium dark:bg-lime-950/40" if other.id == run.id %>">
                <td class="px-2 py-1.5"><%= link_to overview_date(other.local_started_at), run_path(other), class: "hover:underline" %></td>
                <td class="px-2 py-1.5 text-right"><%= overview_distance(other.distance_m / 1000) %> km</td>
                <td class="px-2 py-1.5 text-right"><%= overview_pace(other.pace) %> /km</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</section>
