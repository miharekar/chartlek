<% if @pr_progress.empty? %>
  <h1 class="text-2xl font-semibold">PR Progress</h1>
  <p class="mt-2 text-zinc-500">No runs to show yet.</p>
<% else %>
  <%= tag.div data: {controller: "pr-progress", pr_progress_data_value: @pr_progress.data, pr_progress_mode_value: @mode, pr_progress_days_value: @days}, class: "space-y-6" do %>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="flex items-center gap-2 text-2xl font-semibold">
          PR Progress
          <%= overview_info "Every run by distance and pace. Distance across on a log scale, pace up (faster is higher). The solid line is your all-time best at each benchmark distance; what lies above it is still to be achieved. The dashed line is your best at each distance inside the window below. PRs you can beat predicts each distance from the best VDOT run of the last 30, 60 or 90 days, or any run you click. Magic PRs shows the next round time below each PR, with the three closest targets pulsing." %>
        </h1>
      </div>
      <div class="flex gap-1 rounded-lg bg-zinc-100 p-1 dark:bg-zinc-900" role="group" aria-label="Mode">
        <button type="button" data-action="pr-progress#setMode" data-mode="progress" aria-pressed="false" class="<%= pr_progress_button_class %>">Progress</button>
        <button type="button" data-action="pr-progress#setMode" data-mode="beat" aria-pressed="false" class="<%= pr_progress_button_class %>">PRs you can beat</button>
        <button type="button" data-action="pr-progress#setMode" data-mode="magic" aria-pressed="false" class="<%= pr_progress_button_class %>">Magic PRs</button>
      </div>
    </div>

    <section class="<%= WidgetsHelper::CARD %>">
      <div class="mb-3 flex min-h-8 flex-wrap items-center gap-x-4 gap-y-2 text-sm">
        <div class="hidden flex-wrap items-center gap-3" data-pr-progress-target="beat">
          <span class="text-zinc-500">Best run of the last</span>
          <div class="flex gap-1 rounded-lg bg-zinc-100 p-1 dark:bg-zinc-900" role="group" aria-label="Reference period">
            <% PrProgress::REFERENCE_DAYS.each do |days| %>
              <button type="button" data-action="pr-progress#setDays" data-days="<%= days %>" aria-pressed="false" class="<%= pr_progress_button_class %> !py-0.5"><%= days %> days</button>
            <% end %>
          </div>
          <span class="text-zinc-500" data-pr-progress-target="reference"></span>
        </div>
        <p class="hidden <%= WidgetsHelper::HINT %>" data-pr-progress-target="magic">Next round time below each PR. The three closest targets pulse.</p>
        <div class="ml-auto flex flex-wrap items-center gap-4 <%= WidgetsHelper::HINT %>" data-pr-progress-target="legend"></div>
      </div>
      <div data-pr-progress-target="chart" class="relative"></div>
    </section>

    <section class="<%= WidgetsHelper::CARD %>">
      <div class="mb-1 flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="flex items-center gap-1.5 <%= WidgetsHelper::CARD_TITLE %>">
          Window
          <%= overview_info "Drag to pick a period. The table compares your best at each distance in it with your all-time PR, and shows days since your last run at that distance and since your PR as it stood at the end of the window." %>
        </h2>
        <p class="text-sm text-zinc-500 tabular-nums" data-pr-progress-target="range"></p>
      </div>
      <div data-pr-progress-target="timeline"></div>
    </section>

    <section class="<%= WidgetsHelper::CARD %>">
      <div class="overflow-x-auto">
        <table class="w-full text-sm tabular-nums" data-pr-progress-target="table"></table>
      </div>
    </section>
  <% end %>
<% end %>
