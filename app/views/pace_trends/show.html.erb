<%= tag.div data: (@pace_trend.runs.any? ? {controller: "pace-trends", pace_trends_payload_value: @pace_trend.payload} : {}) do %>
<div class="flex flex-wrap items-center justify-between gap-4">
  <h1 class="flex items-center gap-2 text-2xl font-semibold">
    Pace Trends
    <%= overview_info "#{vdot_explanation} Every run is a muted dot, scored by VDOT so all distances share one scale. Bright dots are top runs: the top 3 by score in the 30 days ending on that run. The band is the least-squares line through the top runs in the window, plus or minus one standard deviation of the residuals. Drag the timeline to change the window." %>
  </h1>
  <div class="flex flex-wrap items-center gap-2">
    <%= pace_trend_filter_chips %>
  </div>
</div>

<% if @pace_trend.runs.any? %>
  <div class="mt-6">
    <div class="flex flex-wrap items-start justify-between gap-x-8 gap-y-3">
      <div>
        <div class="text-sm font-semibold tabular-nums" data-pace-trends-target="range"></div>
        <div class="<%= WidgetsHelper::HINT %>">Pick a span or drag the timeline below to change the window.</div>
        <div class="mt-2"><%= pace_trend_presets %></div>
      </div>
      <div class="text-sm tabular-nums sm:text-right">
        <div data-pace-trends-target="change"></div>
        <div data-pace-trends-target="cut">
          <span data-pace-trends-target="verb"></span> <strong data-pace-trends-target="delta"></strong> from your estimated
          <select data-action="pace-trends#changeDistance" data-pace-trends-target="distance" aria-label="Finish distance" class="rounded border border-zinc-300 bg-transparent px-1 py-0.5 text-sm font-medium dark:border-zinc-700 dark:bg-zinc-950">
            <%= options_for_select(PaceTrend::DISTANCES.map(&:first), @pace_trend.distance) %>
          </select>
          finish time
          <%= overview_info "Predicted time at the chosen distance from the regression VDOT at the start of the window versus the end. Faster is Cut, slower is Added." %>
        </div>
        <div class="text-zinc-500" data-pace-trends-target="message" hidden>Not enough top runs in this window to draw a trend.</div>
      </div>
    </div>
    <div data-pace-trends-target="chart" class="mt-3 w-full"></div>
    <div data-pace-trends-target="timeline" class="mt-2 w-full"></div>
  </div>
<% else %>
  <p class="mt-8 text-zinc-500">No runs to show<%= " with these filters" if request.query_parameters.slice("no_pauses", "no_indoor", "races").any? %>.</p>
<% end %>
<% end %>
