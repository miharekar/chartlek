<% period = overview.period %>
<section class="mt-4 rounded-xl border border-zinc-200 bg-white p-5 dark:border-zinc-800 dark:bg-zinc-900/50" data-controller="heatmap" data-heatmap-data-value="<%= overview.heatmap.to_json %>">
  <div class="flex items-center justify-between gap-4">
    <h2 class="flex items-center gap-1.5 font-semibold">
      <%= period.all_time? ? "Weekly stats for each year" : "Daily stats for #{overview_period_title(period)}" %>
      <%= overview_info(period.all_time? ? "One cell per week (Monday start), colored by kilometers run. Rings mark weeks over 60 km, rings with a dot over 80 km. The alternate scale buckets weeks by your own distribution." : "One cell per day, colored by kilometers run. Click a day to open its run.") %>
    </h2>
    <% if period.all_time? %>
      <button type="button" class="text-sm text-zinc-500 underline decoration-zinc-300 hover:text-zinc-900 dark:text-zinc-400 dark:decoration-zinc-600 dark:hover:text-zinc-100" data-action="heatmap#toggleScale" data-heatmap-target="toggle" aria-pressed="false">alternate scale</button>
    <% end %>
  </div>
  <div class="mt-3" data-heatmap-target="chart"></div>
</section>
