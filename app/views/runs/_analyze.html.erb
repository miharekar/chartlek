<% runs = run.prior_training %>
<section class="mt-4 <%= WidgetsHelper::CARD %>" <%= tag.attributes(data: (runs.any? ? {controller: "analyze-run", analyze_run_runs_value: runs, analyze_run_from_value: run.local_started_at.beginning_of_day.to_i * 1000 - Activity::TRAINING_WINDOW * 86_400_000, analyze_run_to_value: run.local_started_at.to_i * 1000, analyze_run_current_value: run.training_point.merge(race: run.race)} : {})) %>>
  <h2 class="flex items-center gap-1.5 <%= WidgetsHelper::CARD_TITLE %>">
    Training in the prior <%= Activity::TRAINING_WINDOW %> days
    <%= overview_info "Runs in the 90 days before this one. The histogram groups them by distance, pace, heart rate or VDOT. Drag across it to highlight those runs on the timeline below and see their share of the training. Click a bar on the timeline to open the run." %>
  </h2>
  <% if runs.any? %>
    <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
      <label class="flex items-center gap-1.5 text-zinc-500 dark:text-zinc-400">
        Group by
        <select class="field-sizing-content cursor-pointer rounded bg-transparent font-semibold text-lime-700 dark:text-[#9CFF44]" data-action="analyze-run#metric" aria-label="Metric">
          <option value="km" class="text-zinc-900">distance</option>
          <option value="pace" class="text-zinc-900">pace</option>
          <option value="hr" class="text-zinc-900">avg HR</option>
          <option value="vdot" class="text-zinc-900">VDOT</option>
        </select>
      </label>
      <div class="tabular-nums" data-analyze-run-target="summary"></div>
    </div>
    <div class="mt-2" data-analyze-run-target="histogram"></div>
    <div class="mt-2" data-analyze-run-target="timeline"></div>
    <p class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 <%= WidgetsHelper::HINT %>">
      <span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-sm" style="background: var(--chart-highlight)"></span>This run</span>
      <span class="inline-flex items-center gap-1.5"><span class="h-0 w-3 border-t border-dashed" style="border-color: var(--chart-axis)"></span>Average</span>
      <span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-sm" style="background: var(--chart-accent)"></span>Previous runs</span>
    </p>
  <% else %>
    <p class="mt-3 <%= WidgetsHelper::HINT %>">No runs in the 90 days before this one.</p>
  <% end %>
</section>
