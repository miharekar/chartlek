<% period = overview.period %>
<% years = overview.years(period.year) %>
<nav class="mt-4 flex flex-wrap items-center gap-1" aria-label="Period">
  <%= overview_pill "All time", overview_path, period.all_time? ? :selected : :idle %>
  <% years.each do |year| %>
    <%= overview_pill year, overview_period_path(year), period.year == year ? :selected : :idle %>
  <% end %>
</nav>
<% if period.year %>
  <% active_months = overview.months_with_runs(period.year) %>
  <nav class="mt-2 flex flex-wrap items-center gap-1" aria-label="Month">
    <% (1..12).each do |month| %>
      <% state = if period.month == month
        :selected
      elsif active_months.include?(month)
        :idle
      else
        :disabled
      end %>
      <%= overview_pill Date::ABBR_MONTHNAMES[month], (period.month == month ? overview_period_path(period.year) : overview_period_path(period.year, month)), state %>
    <% end %>
  </nav>
<% end %>
