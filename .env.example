# bin/configure writes .env from this file. Keep .env private: never commit it.

# Required

# Garmin Personal API key (connect.garmin.com/app/settings/personalApiToken)
GARMIN_API_TOKEN=

# Filled in by bin/configure. Keep it: a new one means connecting Strava again
SECRET_KEY_BASE=

# Optional

# Strava, for the years before Garmin and gear. Create an API app at
# strava.com/settings/api with Authorization Callback Domain localhost (or your own host),
# copy its Client ID and Client Secret here, then click Connect Strava in the nav, which
# gets the tokens
STRAVA_CLIENT_ID=
STRAVA_SECRET=

# Smashrun login, only for the pre-Garmin backfill
SMASHRUN_USERNAME=
SMASHRUN_PASSWORD=

# Mapbox public token (starts with pk.), enables the maps. Never use a secret sk. token
MAPBOX_TOKEN=

# Cloudflare Tunnel token, only for Strava webhooks. Uncomment COMPOSE_PROFILES to start
# the tunnel with docker compose up
TUNNEL_TOKEN=
# COMPOSE_PROFILES=tunnel

# Hours between the periodic Garmin syncs, a whole number from 1 to 24 (default shown)
# GARMIN_SYNC_HOURS=3

# Puma tuning
# RAILS_MAX_THREADS=3
# WEB_CONCURRENCY=
# JOB_CONCURRENCY=1
# RAILS_LOG_LEVEL=info
