<!DOCTYPE html>
<html data-theme="<%= current_theme %>">
  <head>
    <title><%= content_for(:title) || "Chartlek" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Chartlek">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <% turbo_refreshes_with method: :replace, scroll: :preserve %>
    <% turbo_exempts_page_from_cache %>
    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-white text-zinc-900 dark:bg-zinc-950 dark:text-zinc-100 font-sans antialiased" data-controller="live-refresh">
    <%= turbo_stream_from :garmin_sync, data: {live_refresh_target: "stream"} %>
    <nav aria-label="Main" class="border-b border-zinc-200 dark:border-zinc-800">
      <div class="max-w-7xl mx-auto px-5 min-h-14 py-2 flex flex-wrap items-center gap-x-8 gap-y-2">
        <%= link_to "Chartlek", "/overview", class: "text-lg font-semibold text-lime-700 dark:text-[#9CFF44]" %>
        <div class="flex flex-wrap items-center gap-x-6 gap-y-1 text-sm">
          <%= nav_link_to "Overview", "/overview" %>
          <%= nav_link_to "Runs", runs_path %>
          <%= nav_link_to "Performance", pace_trend_path, match: [pace_trend_path, pr_progress_path] %>
          <%= nav_link_to "Wellness", wellness_path %>
          <%= nav_link_to "Training Bands", training_bands_path %>
          <%= nav_link_to "Gear", gears_path %>
          <%= nav_link_to "Goals", goals_path %>
        </div>
        <div class="ml-auto flex flex-wrap items-center gap-x-3 gap-y-2 text-sm <%= WidgetsHelper::MUTED %>">
          <%= github_link %>
          <%= render "syncs/status", profile: sync_profile %>
          <%= button_to "Sync now", sync_path, class: ControlsHelper::BUTTON %>
          <% unless sync_profile.strava_gear_access? %>
            <%= button_to (sync_profile.strava_reconnect? ? "Reconnect Strava" : "Connect Strava"), strava_connection_path, form: {data: {turbo: false}}, class: ControlsHelper::BUTTON %>
          <% end %>
          <%= theme_switch %>
        </div>
      </div>
    </nav>
    <%= render "syncs/invalid_key_banner" if sync_profile.invalid_key? %>
    <% flash.each do |type, message| %>
      <p class="max-w-7xl mx-auto px-5 pt-4 text-sm <%= (type == "alert") ? "text-red-700 dark:text-red-400" : "text-lime-700 dark:text-[#9CFF44]" %>" role="status"><%= message %></p>
    <% end %>
    <main class="max-w-7xl mx-auto px-5 py-8">
      <%= yield %>
    </main>
  </body>
</html>
