<section class="<%= WidgetsHelper::CARD %>" data-controller="period-bars" data-period-bars-data-value="<%= overview.bars.to_json %>">
  <div class="<%= WidgetsHelper::CARD_HEADER %>">
    <h2 class="<%= WidgetsHelper::CARD_TITLE %>">
      <span data-period-bars-target="title">Distance per <%= overview.period.granularity %></span>
      <%= overview_info "Each bar sums or averages your runs in that #{overview.period.granularity}. Pick another metric on the right. Click a bar to drill in." %>
    </h2>
    <%= button_group "Metric" do %>
      <% [["Distance", "distance"], ["Elevation gained", "elevation"], ["Avg distance", "avg_distance"], ["Avg pace", "avg_pace"], ["Avg VDOT", "avg_vdot"]].each do |label, key| %>
        <%= segment label, selected: key == "distance", value: key, data: {action: "period-bars#metric", period_bars_target: "metric"} %>
      <% end %>
    <% end %>
  </div>
  <div class="mt-3 h-64" data-period-bars-target="chart"></div>
</section>
