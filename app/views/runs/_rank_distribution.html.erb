<div class="mt-3" data-controller="rank-distribution" data-rank-distribution-values-value="<%= values.to_json %>" data-rank-distribution-current-value="<%= current %>" data-rank-distribution-metric-value="<%= metric %>">
  <div data-rank-distribution-target="chart" role="group" aria-label="<%= metric == "pace" ? "Pace distribution for runs within ten percent of this distance" : "Distance distribution of all runs" %>; current run highlighted"></div>
  <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Amber marks this run. <%= metric == "pace" ? "Faster ← pace (min/km) → slower" : "Distance (km)" %></p>
</div>
