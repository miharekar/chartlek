<% times = run.hr_zone_times(zones) %>
<% effort = times && run_effort_tiles(run.effort) %>
<% dynamics = times ? run_dynamics(run.running_dynamics) : [] %>
<% going_in = run_going_in_tiles(run.going_in.to_h) %>
<% if times || going_in.any? %>
  <div class="mt-4 grid gap-4 lg:grid-cols-3">
    <% if times %>
      <section class="<%= WidgetsHelper::CARD %> <%= going_in.any? ? "lg:col-span-2" : "lg:col-span-3" %>">
        <h2 class="<%= WidgetsHelper::CARD_TITLE %>">Heart rate zones and effort <%= overview_info "Time in each zone, with the bpm ranges of the zones set on your watch for that run. When a run has no recorded zones they are estimated: the typical zones of the 100 recorded runs just before it, or of your first 100 for the oldest runs." %></h2>
        <% summary = times.map { "zone #{it[:zone]} #{run_zone_minutes(it[:seconds])}, #{it[:percent]} percent" }.join("; ") %>
        <div class="mt-4 flex h-5 overflow-hidden rounded-sm ring-1 ring-zinc-200 dark:ring-zinc-700" role="group" aria-label="Time in heart rate zones: <%= summary %>" data-controller="hr-zones">
          <% times.select { it[:seconds].positive? }.each_with_index do |zone, index| %>
            <% range = "#{zone[:from]}–#{zone[:to]} bpm" if zone[:from] %>
            <span class="min-w-1 outline-offset-[-2px]" style="flex: <%= zone[:seconds].round(1) %> 1 0; background: var(--hr-zone-<%= zone[:zone] %>)" tabindex="<%= index.zero? ? 0 : -1 %>" role="img" aria-label="Zone <%= zone[:zone] %>: <%= run_zone_minutes(zone[:seconds]) %>, <%= zone[:percent] %> percent<%= ", #{range}" if range %>" data-hr-zones-target="segment" data-title="Zone <%= zone[:zone] %>" data-rows="<%= [["Time", run_zone_minutes(zone[:seconds])], ["Share", "#{zone[:percent]}%"], (["Heart rate", range] if range)].compact.to_json %>" data-action="mousedown->hr-zones#press focus->hr-zones#focus blur->hr-zones#blur keydown->hr-zones#key"></span>
          <% end %>
        </div>
        <dl class="mt-2 grid grid-cols-5 gap-2 text-xs tabular-nums">
          <% times.each do |zone| %>
            <div class="min-w-0">
              <dt class="flex items-center gap-1 font-medium"><span class="size-2 shrink-0 rounded-full" style="background: var(--hr-zone-<%= zone[:zone] %>)"></span><span class="sm:hidden">Z<%= zone[:zone] %></span><span class="hidden sm:inline">Zone <%= zone[:zone] %></span></dt>
              <dd class="<%= WidgetsHelper::MUTED %>"><%= run_zone_minutes(zone[:seconds]) %></dd>
              <dd class="<%= WidgetsHelper::MUTED %>"><%= zone[:percent] %>%</dd>
              <% if zone[:from] %><dd class="<%= WidgetsHelper::MUTED %>"><%= zone[:from] %>–<%= zone[:to] %></dd><% end %>
            </div>
          <% end %>
        </dl>
        <% if zones&.estimated? %>
          <p class="mt-2 <%= WidgetsHelper::HINT %>"><%= chip "Estimated zones", :estimated %> <%= run.predates_fit_zones? ? "This run is from before your watch recorded its zones, so the ranges and times use the typical zones of your first recorded runs." : "This run has no recorded zones, so the ranges and times use the typical zones of the runs just before it." %></p>
        <% elsif zones&.default? %>
          <p class="mt-2 <%= WidgetsHelper::HINT %>">Zone ranges use Garmin's default bands of your highest recorded max HR.</p>
        <% end %>
        <% if effort.any? %>
          <div class="mt-5"><%= render "physiology_tiles", tiles: effort %></div>
        <% end %>
        <% if dynamics.any? %>
          <dl class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm tabular-nums">
            <% dynamics.each do |label, value| %>
              <div class="flex items-baseline gap-1.5"><dt class="<%= WidgetsHelper::MUTED %>"><%= label %></dt><dd class="font-medium"><%= value %></dd></div>
            <% end %>
          </dl>
        <% end %>
      </section>
    <% end %>

    <% if going_in.any? %>
      <section class="<%= WidgetsHelper::CARD %> <%= times ? "lg:col-span-1" : "lg:col-span-3" %>">
        <h2 class="<%= WidgetsHelper::CARD_TITLE %>">Going in</h2>
        <div class="mt-4"><%= render "physiology_tiles", tiles: going_in %></div>
      </section>
    <% end %>
  </div>
<% end %>
