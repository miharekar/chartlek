<% card = WidgetsHelper::CARD %>
<% label = WidgetsHelper::TILE_LABEL %>
<% big = WidgetsHelper::TILE_VALUE %>
<% unit = WidgetsHelper::TILE_UNIT %>
<% sub = WidgetsHelper::TILE_SUB %>
<% goal_to_create = overview.goal_to_create %>

<section class="<%= card %> col-span-2<%= " lg:col-span-4" if overview.goal_tiles.empty? %>">
  <h2 class="<%= label %>">Kilometers run</h2>
  <p class="<%= big %> <%= WidgetsHelper::ACCENT %>"><%= number_with_delimiter(overview.total_km.round) %><span class="<%= unit %>">km</span></p>
  <p class="<%= sub %> first-letter:uppercase"><%= overview.total_km_in_words %></p>
  <p class="<%= sub %>"><%= pluralize(number_with_delimiter(overview.count), "run") %></p>
  <% if goal_to_create %>
    <p class="<%= sub %>"><%= link_to "Create a goal for #{goal_to_create.title}", new_goal_path(period: goal_to_create.period, starts_on: goal_to_create.starts_on), class: WidgetsHelper::LINK %></p>
  <% end %>
</section>

<%= render partial: "goal_tile", collection: overview.goal_tiles, as: :slot, locals: {span: goal_tile_span(overview.goal_tiles)} %>

<section class="<%= card %>">
  <h2 class="<%= label %>">Average run length</h2>
  <p class="<%= big %>"><%= overview_distance(overview.average_km) %><span class="<%= unit %>">km</span></p>
</section>

<section class="<%= card %>">
  <h2 class="<%= label %>">Average days per week</h2>
  <p class="<%= big %>"><%= overview_distance(overview.days_per_week) %><span class="<%= unit %>">days</span></p>
</section>

<section class="<%= card %>">
  <h2 class="<%= label %>">Time of day</h2>
  <div class="mt-1 flex items-center gap-3">
    <p class="<%= big %>"><%= overview.pm_percent %><span class="<%= unit %>">% PM</span></p>
    <div class="ml-auto size-12 shrink-0 rounded-full" title="<%= overview.pm_count %> PM, <%= overview.count - overview.pm_count %> AM" style="background: conic-gradient(var(--chart-accent) 0 <%= overview.pm_percent %>%, var(--chart-accent-low) 0); mask: radial-gradient(circle, transparent 55%, #000 56%); -webkit-mask: radial-gradient(circle, transparent 55%, #000 56%)"></div>
  </div>
</section>

<section class="<%= card %>">
  <h2 class="<%= label %>">Average pace</h2>
  <p class="<%= big %>"><%= overview_pace(overview.average_pace) %><span class="<%= unit %>">/km</span></p>
</section>
