<% if slot %>
  <div class="mt-6 flex flex-wrap items-stretch gap-4">
    <% if slot.goal %>
      <% progress = slot.progress %>
      <section class="<%= WidgetsHelper::CARD %> min-w-72 flex-1">
        <div class="flex items-baseline justify-between gap-2">
          <h2 class="<%= WidgetsHelper::TILE_LABEL %>"><%= link_to "#{slot.goal.title} goal", goal_path(slot.goal), class: WidgetsHelper::LINK %></h2>
          <span class="<%= WidgetsHelper::TILE_LABEL %> tabular-nums"><%= progress.percent %>%</span>
        </div>
        <p class="mt-1 text-2xl font-semibold tabular-nums <%= WidgetsHelper::ACCENT %>"><%= overview_distance(progress.done_km) %><span class="<%= WidgetsHelper::TILE_UNIT %>">of <%= overview_distance(slot.goal.distance_km) %> km</span></p>
        <%= render "goal_bar", goal: slot.goal, progress: progress %>
        <p class="<%= WidgetsHelper::TILE_SUB %>">
          <span class="<%= goal_status_class(progress) %>"><%= goal_status(progress) %></span>
          <% if goal_required(progress) %>
            <span class="<%= WidgetsHelper::MUTED %>">· <%= goal_required(progress) %> needed</span>
          <% end %>
        </p>
      </section>
    <% else %>
      <p class="self-center <%= WidgetsHelper::HINT %>"><%= link_to "Set a monthly goal", new_goal_path(period: slot.kind, starts_on: slot.starts_on), class: WidgetsHelper::LINK %></p>
    <% end %>
  </div>
<% end %>
