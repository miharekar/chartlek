<% records = overview.records %>
<% if records.any? %>
<% th = "#{WidgetsHelper::CELL} text-right font-medium" %>
<section class="mt-4 <%= WidgetsHelper::CARD %>">
  <h2 class="<%= WidgetsHelper::CARD_TITLE %>">Personal records</h2>
  <div class="mt-3 overflow-x-auto">
    <table class="<%= WidgetsHelper::TABLE %>">
      <thead class="<%= WidgetsHelper::TABLE_HEAD %>">
        <tr class="<%= WidgetsHelper::TABLE_HEAD_ROW %>">
          <th class="<%= WidgetsHelper::CELL %> text-left font-medium">Distance</th>
          <th class="<%= WidgetsHelper::CELL %> text-left font-medium">Date</th>
          <th class="<%= th %>">Pace</th>
          <th class="<%= th %> hidden sm:table-cell">km/h</th>
          <th class="<%= th %>">Time</th>
          <th class="<%= th %> hidden sm:table-cell">Runs</th>
        </tr>
      </thead>
      <tbody class="<%= WidgetsHelper::TABLE_BODY %>">
        <% records.each do |record| %>
          <tr class="<%= WidgetsHelper::TABLE_ROW %>">
            <td class="<%= WidgetsHelper::CELL %> font-medium"><%= link_to record.name, run_path(record.activity), class: WidgetsHelper::TABLE_LINK %><% if record.race %> <%= chip "race", :race %><% end %></td>
            <td class="<%= WidgetsHelper::CELL %> text-zinc-600 dark:text-zinc-300"><%= link_to overview_date(record.activity.local_started_at), run_path(record.activity), class: WidgetsHelper::TABLE_LINK %></td>
            <td class="<%= WidgetsHelper::CELL %> text-right"><%= overview_pace(record.pace) %> <span class="<%= WidgetsHelper::HINT %>">/km</span></td>
            <td class="<%= WidgetsHelper::CELL %> hidden text-right sm:table-cell"><%= format("%.2f", record.speed_kmh) %></td>
            <td class="<%= WidgetsHelper::CELL %> text-right font-medium"><%= overview_duration(record.time_s) %></td>
            <td class="<%= WidgetsHelper::CELL %> hidden text-right sm:table-cell <%= WidgetsHelper::MUTED %>"><%= number_with_delimiter(record.count) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <p class="mt-3 <%= WidgetsHelper::HINT %>">All distances are rounded down and times are interpolated.</p>
</section>
<% end %>
