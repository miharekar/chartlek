<%= form_with model: goal, class: "mt-6 #{WidgetsHelper::CARD} max-w-xl space-y-5" do |form| %>
  <% if goal.errors.any? %>
    <ul class="text-sm text-red-700 dark:text-red-400" role="alert">
      <% goal.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <fieldset>
    <legend class="<%= WidgetsHelper::TILE_LABEL %>">Period</legend>
    <div class="mt-2 flex gap-6 text-sm">
      <% Goal::PERIODS.each do |period| %>
        <label class="inline-flex items-center gap-2">
          <%= form.radio_button :period, period, class: "accent-lime-700" %>
          <%= period.capitalize %>
        </label>
      <% end %>
    </div>
  </fieldset>

  <div>
    <%= form.label :starts_on, "Any day in the month or year", class: WidgetsHelper::TILE_LABEL %>
    <div class="mt-2"><%= form.date_field :starts_on, class: ControlsHelper::INPUT, required: true %></div>
  </div>

  <div>
    <%= form.label :distance_km, "Distance (km)", class: WidgetsHelper::TILE_LABEL %>
    <div class="mt-2"><%= form.number_field :distance_km, value: (goal.distance_km && goal.distance_km.round(1)), step: 0.1, min: 0.1, class: ControlsHelper::INPUT, required: true %></div>
  </div>

  <div class="flex flex-wrap gap-2">
    <%= form.submit class: ControlsHelper::BUTTON %>
    <%= action_button "Cancel", (goal.persisted? ? goal_path(goal) : goals_path) %>
  </div>
<% end %>
